---
/**
 * quiet-callout — a gentle aside that speaks directly and softly to the reader.
 *
 * WHEN TO USE: a moment of reassurance or care that should feel like a hand on
 * the shoulder, especially on safety pages. Tone 'care' uses the warm accent.
 * WHEN NOT TO USE: for ordinary emphasis (use pull-quote) or for warnings that
 * create urgency or fear — Garden never does that.
 */
import type { QuietCalloutContent } from '@engine/content-types.ts';

interface Props {
  content?: unknown;
}

const { content } = Astro.props;
const c = (content ?? { text: '' }) as QuietCalloutContent;
const tone = c.tone ?? 'plain';
---

<aside class={`callout callout--${tone}`} data-reveal>
  <div class="wr-shell callout__inner">
    {c.label && <p class="callout__label">{c.label}</p>}
    <p class="callout__text">{c.text}</p>
  </div>
</aside>

<style>
  .callout {
    padding-block: var(--space-l);
  }

  .callout__inner {
    max-width: var(--measure);
    padding: var(--space-l) var(--space-l) var(--space-l) var(--space-xl);
    position: relative;
    border-radius: var(--radius-m);
  }

  .callout--plain .callout__inner {
    background: var(--color-surface);
    border: var(--border-hairline);
  }

  .callout--care .callout__inner {
    background: color-mix(in srgb, var(--color-care) 6%, var(--color-surface));
    border: 1px solid color-mix(in srgb, var(--color-care) 24%, transparent);
  }

  /* A soft vertical mark, like a margin note, rather than a boxed alert. */
  .callout__inner::before {
    content: '';
    position: absolute;
    inset-block: var(--space-l);
    inset-inline-start: var(--space-m);
    inline-size: 2px;
    border-radius: 1px;
    background: var(--color-accent);
  }

  .callout--care .callout__inner::before {
    background: var(--color-care);
  }

  .callout__label {
    font-size: var(--step--1);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-faint);
    margin-bottom: var(--space-2xs);
  }

  .callout__text {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: var(--leading-snug);
    color: var(--color-text);
    text-wrap: pretty;
  }
</style>
