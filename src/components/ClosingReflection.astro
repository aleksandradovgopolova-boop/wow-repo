---
/**
 * closing-reflection — an intentional ending. A last line that lets the page
 * settle rather than sell.
 *
 * WHEN TO USE: as the final content section of a page, before next-path. Every
 * page should end on purpose.
 * WHEN NOT TO USE: mid-page, or as a call-to-action. It is a resting point, not
 * a conversion.
 */
import type { ClosingReflectionContent } from '@engine/content-types.ts';

interface Props {
  content?: unknown;
}

const { content } = Astro.props;
const c = (content ?? { line: '' }) as ClosingReflectionContent;
---

<section class="closing" data-reveal>
  <div class="wr-shell closing__inner">
    <span class="closing__mark" aria-hidden="true"></span>
    <p class="closing__line">{c.line}</p>
    {c.sub && <p class="closing__sub">{c.sub}</p>}
  </div>
</section>

<style>
  .closing {
    padding-block: var(--space-2xl);
    text-align: center;
  }

  .closing__inner {
    display: grid;
    justify-items: center;
    gap: var(--space-m);
    max-width: 30ch;
    margin-inline: auto;
  }

  /* A small growing mark — a sprout, closing the page as a living thing. */
  .closing__mark {
    inline-size: 1.5rem;
    block-size: 1.5rem;
    background: var(--color-accent);
    border-start-start-radius: 60% 60%;
    border-start-end-radius: 20% 20%;
    border-end-end-radius: 60% 60%;
    border-end-start-radius: 20% 20%;
    transform: rotate(45deg);
    opacity: 0.85;
  }

  .closing__line {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    text-wrap: balance;
  }

  .closing__sub {
    font-size: var(--step-0);
    color: var(--color-text-faint);
  }
</style>
