---
/**
 * related-links — a small set of sibling pages, offered without pressure.
 *
 * WHEN TO USE: to gently surface a few connected pages from the plan's
 * `relationships.related`. Rendered as a quiet list, never a grid of cards.
 * WHEN NOT TO USE: for a single onward step (use next-path) or to cram every
 * page into a footer menu.
 */
import type { RelatedLinksContent } from '@engine/content-types.ts';
import type { ResolvedRepo } from '@engine/load.ts';
import type { PagePlan } from '@engine/page-plan.ts';
import { findPage, pageHref } from '@engine/load.ts';

interface Props {
  content?: unknown;
  plan: PagePlan;
  repo: ResolvedRepo;
}

const { content, plan, repo } = Astro.props;
const c = (content ?? {}) as RelatedLinksContent;
const related = plan.relationships.related
  .map((id) => findPage(repo, id))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));
---

{
  related.length > 0 && (
    <nav class="related" aria-label="Related pages" data-reveal>
      <div class="wr-shell related__inner">
        {c.intro && <p class="related__intro">{c.intro}</p>}
        <ul class="related__list">
          {related.map((p) => (
            <li>
              <a class="related__link" href={pageHref(repo, p.plan.page.path)}>
                <span class="related__title">{p.plan.page.title}</span>
                <span class="related__summary">{p.plan.page.summary}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  )
}

<style>
  .related {
    padding-block: var(--space-l);
  }

  .related__inner {
    display: grid;
    gap: var(--space-m);
    max-width: var(--measure);
  }

  .related__intro {
    font-size: var(--step--1);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .related__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-xs);
  }

  .related__link {
    display: grid;
    gap: var(--space-3xs);
    padding-block: var(--space-s);
    border-block-end: var(--border-hairline);
    text-decoration: none;
    color: var(--color-text);
    transition: padding-inline-start var(--dur-quick) var(--ease-standard);
  }

  .related__list li:last-child .related__link {
    border-block-end: 0;
  }

  .related__link:hover {
    padding-inline-start: var(--space-2xs);
  }

  .related__title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--color-text);
  }

  .related__link:hover .related__title {
    color: var(--color-accent-strong);
  }

  .related__summary {
    font-size: var(--step--1);
    color: var(--color-text-faint);
  }
</style>
