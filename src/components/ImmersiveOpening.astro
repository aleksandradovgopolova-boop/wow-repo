---
/**
 * immersive-opening — a full-bleed, atmospheric first breath.
 *
 * WHEN TO USE: a page that should open with feeling before information (the
 * manifesto). Large, quiet lines with generous space around them.
 * WHEN NOT TO USE: when the reader needs an immediate title/orientation — use
 * editorial-hero. Never use more than one per page.
 */
import type { ImmersiveOpeningContent } from '@engine/content-types.ts';

interface Props {
  content?: unknown;
}

const { content } = Astro.props;
const c = (content ?? { lines: [] }) as ImmersiveOpeningContent;
---

<section class="opening">
  <div class="wr-shell opening__inner">
    {c.eyebrow && <p class="wr-label opening__eyebrow" data-reveal>{c.eyebrow}</p>}
    <h1 class="opening__lines">
      {
        c.lines.map((line, i) => (
          <span
            class="opening__line"
            data-reveal
            style={`transition-delay:${i * 120}ms`}
          >
            {line}
          </span>
        ))
      }
    </h1>
    {c.footnote && <p class="opening__footnote" data-reveal>{c.footnote}</p>}
  </div>
</section>

<style>
  .opening {
    min-block-size: min(86vh, 46rem);
    display: flex;
    align-items: center;
    padding-block: var(--space-3xl) var(--space-2xl);
  }

  .opening__inner {
    display: grid;
    gap: var(--space-l);
  }

  .opening__lines {
    display: grid;
    gap: var(--space-2xs);
    font-family: var(--font-display);
    font-size: var(--step-4);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    max-width: 20ch;
    color: var(--color-text);
  }

  .opening__line {
    display: block;
  }

  /* The last line lifts in the living accent — the idea taking root. */
  .opening__line:last-child {
    color: var(--color-accent-strong);
  }

  .opening__footnote {
    max-width: var(--measure-narrow);
    color: var(--color-text-faint);
    font-size: var(--step-0);
    /* Same shared asymmetric column as the editorial-hero lede. */
    margin-inline-start: var(--lede-indent);
  }
</style>
