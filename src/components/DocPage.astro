---
/**
 * DocPage — renders one Markdown document (ingested via loadMarkdownRepo) in
 * the WowRepo design, art-directed per section.
 *
 * One visual grammar runs through the whole site: meaning on the left (text),
 * a living botanical form on the right. On the landing that form is the
 * generative canopy (WebGL); on every chapter it is a hand-drawn motif chosen
 * for the section's place in the journey — a day/growth arc from first sprout
 * to evening leaves. Sub-pages inherit their chapter's scene, so a section
 * reads as one room.
 *
 * Scenes are assigned by a section's position in the reading order, so the
 * component stays generic (no site-specific strings) while each page still
 * feels designed around its content. Reading bodies stay calm paper — the art
 * lives in the chapter header, which is CSS + inline SVG (no per-page WebGL),
 * so pages paint instantly.
 */
import '../styles/tokens.css';
import '../styles/base.css';
import Atmosphere from './atmosphere/Atmosphere.astro';
import type { MdRepo, MdPage } from '@engine/markdown-repo.ts';
import { readingNeighbours } from '@engine/markdown-repo.ts';

interface Props {
  repo: MdRepo;
  page: MdPage;
  base: string; // site base path, e.g. "/garden"
}

const { repo, page, base } = Astro.props;
const href = (p: string) => (p === '/' ? base || '/' : `${base}${p}`);
const { prev, next } = readingNeighbours(repo, page.path);
const isLanding = page.path === '/';
const title = isLanding ? repo.site.title : `${page.title} · ${repo.site.title}`;

// Sidebar: reading order grouped into sections, expanded at the current one.
const sections = repo.nav.map((n) => ({
  label: n.label,
  entry: n.path,
  pages: repo.pages.filter((p) => p.section === n.label),
}));

// Landing: the guided journey into each section.
const journey = repo.nav.map((n, i) => {
  const entry = repo.pages.find((p) => p.section === n.label);
  return { n: i + 1, label: n.label, path: n.path, title: entry?.title ?? n.label };
});
const landingIntro = isLanding
  ? page.bodyHtml.split(/<(?:h1|h2|h3|ul|ol)[\s>]/i)[0]
  : '';

/* --- Art direction: a scene per chapter, in a day/growth arc --- */
type Scene = { motif: keyof typeof MOTIFS; accent: string; tint: string; warm: string };
const SCENES: Scene[] = [
  { motif: 'sprout', accent: 'var(--_leaf)', tint: 'var(--_dawn)', warm: '18%' },
  { motif: 'roots', accent: 'var(--_leaf-deep)', tint: 'var(--_leaf)', warm: '12%' },
  { motif: 'uprights', accent: 'var(--_leaf-deep)', tint: 'var(--_dawn)', warm: '14%' },
  { motif: 'horizon', accent: 'var(--_leaf)', tint: 'var(--_dawn)', warm: '22%' },
  { motif: 'contours', accent: 'var(--_clay)', tint: 'var(--_dawn)', warm: '20%' },
  { motif: 'rays', accent: 'var(--_clay)', tint: 'var(--_dawn)', warm: '26%' },
  { motif: 'path', accent: 'var(--_leaf-deep)', tint: 'var(--_clay)', warm: '14%' },
  { motif: 'leaves', accent: 'var(--_leaf)', tint: 'var(--_leaf-deep)', warm: '12%' },
];

// Hand-drawn chapter motifs (stroke = currentColor, so the scene accent tints
// them). Simple line art, seated large and faint beside the title.
const MOTIFS = {
  sprout: `<path d="M120 214V96"/><path d="M120 150c-30-8-48-32-52-60 30 4 50 28 52 60Z"/><path d="M120 128c30-10 50-32 54-60-30 4-52 28-54 60Z"/>`,
  roots: `<path d="M120 26v96"/><path d="M120 122c-10 26-34 40-52 46m52-46c10 26 34 40 52 46m-52-46c-2 30-2 56-2 74m2-74c2 30 2 56 2 74"/>`,
  uprights: `<path d="M78 214V70m0 34c-16-4-26-18-28-34 16 2 26 16 28 34Z"/><path d="M120 214V44m0 46c18-5 30-22 32-42-18 2-30 20-32 42Z"/><path d="M162 214V86m0 30c16-4 26-16 28-32-16 2-26 14-28 32Z"/>`,
  horizon: `<path d="M28 158h184"/><path d="M150 158a30 30 0 0 1 60 0"/><path d="M64 158c-2-22-2-38-2-52m2 52c8-10 16-16 24-20"/><path d="M96 158c-1-14-1-24-1-34"/>`,
  contours: `<path d="M120 60c-40 0-70 26-70 60s30 60 70 60 70-26 70-60-30-60-70-60Z"/><path d="M120 92c-24 0-44 13-44 28s20 28 44 28 44-13 44-28-20-28-44-28Z"/><circle cx="120" cy="120" r="10"/>`,
  rays: `<circle cx="120" cy="120" r="26"/><path d="M120 66V40M120 200v-26M174 120h26M40 120h26M158 82l18-18M64 176l18-18M158 158l18 18M64 64l18 18"/>`,
  path: `<path d="M74 216c40-10 40-52 4-66s-36-58 8-70 44-52 8-64"/><circle cx="78" cy="150" r="4" fill="currentColor" stroke="none"/><circle cx="96" cy="86" r="4" fill="currentColor" stroke="none"/><circle cx="102" cy="24" r="4" fill="currentColor" stroke="none"/>`,
  leaves: `<path d="M116 200c-44-6-74-36-74-76 44 6 74 36 74 76Z"/><path d="M124 168c44-6 74-36 74-76-44 6-74 36-74 76Z"/><path d="M116 200V96M124 168V72"/>`,
} as const;

const sectionIndex = page.section
  ? repo.nav.findIndex((n) => n.label === page.section)
  : 0;
const scene = SCENES[(sectionIndex < 0 ? 0 : sectionIndex) % SCENES.length];
const chapterNo = String((sectionIndex < 0 ? 0 : sectionIndex) + 1).padStart(2, '0');
---

<!doctype html>
<html lang={repo.site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={repo.site.description} />
    <meta name="generator" content="WowRepo" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
  </head>
  <body data-landing={isLanding ? 'true' : undefined}>
    <a class="skip-link" href="#doc">Перейти к содержанию</a>

    {isLanding && <Atmosphere variant="canopy-light" intensity="present" />}

    <div class="doc" class:list={[{ 'doc--landing': isLanding }]}>
      <aside class="doc__side">
        <a class="doc__brand" href={href('/')}>
          <span class="doc__seed" aria-hidden="true"></span>
          <span>
            {repo.site.title}
            <span class="doc__brandsub">{repo.site.description}</span>
          </span>
        </a>
        <nav class="doc__nav" aria-label="Разделы">
          {
            sections.map((s, i) => (
              <div class="doc__group">
                <a
                  class="doc__section"
                  href={href(s.entry)}
                  aria-current={page.section === s.label ? 'true' : undefined}
                >
                  <span class="doc__secnum">{String(i + 1).padStart(2, '0')}</span>
                  {s.label}
                </a>
                {page.section === s.label && s.pages.length > 1 && (
                  <ul class="doc__pages">
                    {s.pages.map((p) => (
                      <li>
                        <a
                          href={href(p.path)}
                          aria-current={p.path === page.path ? 'page' : undefined}
                        >
                          {p.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            ))
          }
        </nav>
      </aside>

      <main class="doc__main" id="doc" tabindex="-1">
        {
          isLanding ? (
            <div class="landing">
              <header class="hero">
                <p class="hero__kicker">{repo.site.description}</p>
                <h1 class="hero__title">{repo.site.title}</h1>
                {landingIntro && (
                  <div class="hero__lead doc-prose" set:html={landingIntro} />
                )}
              </header>

              <section class="journey" aria-label="С чего начать">
                <p class="journey__eyebrow">Путь по саду</p>
                <ol class="journey__list">
                  {journey.map((j) => (
                    <li>
                      <a class="journey__row" href={href(j.path)}>
                        <span class="journey__num">
                          {String(j.n).padStart(2, '0')}
                        </span>
                        <span class="journey__body">
                          <span class="journey__label">{j.label}</span>
                          <span class="journey__title">{j.title}</span>
                        </span>
                        <span class="journey__arrow" aria-hidden="true">
                          →
                        </span>
                      </a>
                    </li>
                  ))}
                </ol>
              </section>
            </div>
          ) : (
            <article class="doc__article" style={`--scene-accent:${scene.accent};--scene-tint:${scene.tint};--scene-warm:${scene.warm};`}>
              <header class="chapter">
                <div class="chapter__text">
                  <p class="chapter__eyebrow">
                    <span class="chapter__no">Глава {chapterNo}</span>
                    {page.section && <span class="chapter__sec">{page.section}</span>}
                  </p>
                  <h1 class="chapter__title">{page.title}</h1>
                  {page.updated && (
                    <p class="doc__meta">Обновлено {page.updated}</p>
                  )}
                </div>
                <div class="chapter__art" aria-hidden="true">
                  <svg viewBox="0 0 240 240" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" set:html={MOTIFS[scene.motif]} />
                </div>
              </header>

              <div class="doc-prose" set:html={page.bodyHtml} />

              <nav class="doc__reading" aria-label="Дальше">
                {prev && (
                  <a class="doc__step doc__step--prev" href={href(prev.path)}>
                    <span class="doc__steplabel">Назад</span>
                    <span class="doc__steptitle">{prev.title}</span>
                  </a>
                )}
                {next && (
                  <a class="doc__step doc__step--next" href={href(next.path)}>
                    <span class="doc__steplabel">Дальше</span>
                    <span class="doc__steptitle">{next.title}</span>
                  </a>
                )}
              </nav>
            </article>
          )
        }

        <footer class="doc__foot">
          <span>{repo.site.title}</span>
          <span class="doc__colophon">Собрано с WowRepo</span>
        </footer>
      </main>
    </div>
  </body>
</html>

<style>
  .doc {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(15rem, 18rem) 1fr;
    min-height: 100vh;
    max-width: var(--width-full);
    margin-inline: auto;
  }

  /* --- Sidebar --- */
  .doc__side {
    position: sticky;
    top: 0;
    align-self: start;
    height: 100vh;
    overflow-y: auto;
    padding: var(--space-l) var(--space-m) var(--space-l) var(--gutter);
    border-inline-end: var(--border-hairline);
  }
  .doc--landing .doc__side {
    border-inline-end-color: transparent;
  }
  .doc__brand {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2xs);
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--color-text);
    text-decoration: none;
    margin-bottom: var(--space-xl);
    line-height: var(--leading-snug);
  }
  .doc__brandsub {
    display: block;
    font-family: var(--font-body);
    font-size: var(--step--1);
    color: var(--color-text-faint);
    letter-spacing: 0;
    margin-top: var(--space-3xs);
    max-width: 22ch;
  }
  .doc__seed {
    flex: none;
    inline-size: 0.66em;
    block-size: 0.66em;
    margin-top: 0.15em;
    background: var(--color-accent);
    border-radius: 60% 20% 60% 20% / 60% 20% 60% 20%;
    transform: rotate(45deg);
  }
  .doc__nav {
    display: grid;
    gap: var(--space-2xs);
  }
  .doc__section {
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
    font-size: var(--step-0);
    color: var(--color-text-soft);
    text-decoration: none;
    padding-block: var(--space-3xs);
    border-inline-start: 2px solid transparent;
    padding-inline-start: var(--space-s);
    margin-inline-start: calc(var(--space-s) * -1);
    transition: color var(--dur-quick) var(--ease-standard);
  }
  .doc__secnum {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--color-text-faint);
  }
  .doc__section:hover {
    color: var(--color-text);
  }
  .doc__section[aria-current='true'] {
    color: var(--color-accent-strong);
    border-inline-start-color: var(--color-accent);
    font-weight: var(--weight-semibold);
  }
  .doc__section[aria-current='true'] .doc__secnum {
    color: var(--color-accent);
  }
  .doc__pages {
    list-style: none;
    margin: var(--space-2xs) 0 var(--space-xs);
    padding-inline-start: calc(var(--space-s) + 1.6rem);
    display: grid;
    gap: var(--space-3xs);
  }
  .doc__pages a {
    font-size: var(--step--1);
    color: var(--color-text-faint);
    text-decoration: none;
  }
  .doc__pages a:hover {
    color: var(--color-text-soft);
  }
  .doc__pages a[aria-current='page'] {
    color: var(--color-accent-strong);
  }

  /* --- Reading column --- */
  .doc__main {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 0 var(--gutter) var(--space-xl);
  }
  .doc--landing .doc__main {
    padding-top: var(--space-2xl);
  }
  .doc__article,
  .landing {
    width: 100%;
    flex: 1;
  }
  .doc__article {
    max-width: var(--width-wide);
    margin-inline: auto;
    padding-top: var(--space-xl);
  }
  /* Reading blocks stay at a comfortable measure inside the wider column. */
  .doc__article > .doc-prose,
  .doc__article > .doc__reading {
    max-width: var(--measure);
  }

  /* --- Chapter header (art-directed per section) --- */
  .chapter {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-xl);
    min-height: 38vh;
    padding: var(--space-xl) var(--space-l);
    margin: 0 calc(var(--space-l) * -1) var(--space-2xl);
    border-radius: var(--radius-m);
    border-bottom: var(--border-hairline);
    isolation: isolate;
    overflow: hidden;
  }
  /* Scene light — a crafted glow, contained to the header, dissipating to
     paper. This is a chapter opener's lighting, not a wash behind reading. */
  .chapter::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(
        60% 90% at 82% 30%,
        color-mix(in srgb, var(--scene-tint) var(--scene-warm), transparent) 0%,
        transparent 70%
      ),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--scene-tint) 8%, transparent) 0%,
        transparent 60%
      );
  }
  .chapter__text {
    min-width: 0;
  }
  .chapter__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    flex-wrap: wrap;
    margin: 0 0 var(--space-m);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    font-weight: var(--weight-semibold);
  }
  .chapter__no {
    color: var(--scene-accent);
  }
  .chapter__sec {
    color: var(--color-text-faint);
    position: relative;
    padding-inline-start: var(--space-s);
  }
  .chapter__sec::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 50%;
    width: var(--space-2xs);
    height: 1px;
    background: currentColor;
  }
  .chapter__title {
    font-family: var(--font-display);
    font-size: var(--step-5);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    margin: 0;
    max-width: 15ch;
  }
  .doc__meta {
    font-size: var(--step--1);
    color: var(--color-text-faint);
    margin: var(--space-m) 0 0;
  }
  .chapter__art {
    justify-self: end;
    color: var(--scene-accent);
    width: clamp(9rem, 22vw, 15rem);
    opacity: 0.9;
  }
  .chapter__art svg {
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(0 1px 0 color-mix(in srgb, var(--color-bg) 60%, transparent));
  }

  /* --- Landing hero --- */
  .hero {
    padding-block: var(--space-l) var(--space-2xl);
    max-width: 26rem;
  }
  .hero__kicker {
    font-size: var(--step-0);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-accent-strong);
    font-weight: var(--weight-semibold);
    margin: 0 0 var(--space-m);
    max-width: 30ch;
  }
  .hero__title {
    font-family: var(--font-display);
    font-size: var(--step-6);
    line-height: 0.95;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    margin: 0;
  }
  .hero__lead {
    margin-top: var(--space-l);
    font-size: var(--step-1);
    max-width: 22ch;
  }

  /* --- Landing journey index --- */
  .journey {
    border-top: var(--border-hairline);
    padding-top: var(--space-l);
    max-width: 28rem;
  }
  .journey__eyebrow {
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-faint);
    font-weight: var(--weight-semibold);
    margin: 0 0 var(--space-s);
  }
  .journey__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .journey__row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-m);
    padding: var(--space-m) var(--space-s);
    margin-inline: calc(var(--space-s) * -1);
    border-radius: var(--radius-m);
    text-decoration: none;
    border-bottom: var(--border-hairline);
    transition:
      background-color var(--dur-quick) var(--ease-standard),
      transform var(--dur-quick) var(--ease-standard);
  }
  .journey__list li:last-child .journey__row {
    border-bottom: 0;
  }
  .journey__row:hover {
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
  }
  .journey__num {
    font-family: var(--font-mono);
    font-size: var(--step-0);
    color: var(--color-accent);
    letter-spacing: var(--tracking-wide);
  }
  .journey__body {
    display: grid;
    gap: 0.15em;
    min-width: 0;
  }
  .journey__label {
    font-size: var(--step--1);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-faint);
  }
  .journey__title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: var(--leading-snug);
    color: var(--color-text);
  }
  .journey__row:hover .journey__title {
    color: var(--color-accent-strong);
  }
  .journey__arrow {
    font-size: var(--step-1);
    color: var(--color-accent);
    transition: transform var(--dur-quick) var(--ease-standard);
  }
  .journey__row:hover .journey__arrow {
    transform: translateX(0.35em);
  }

  /* --- Reading path --- */
  .doc__reading {
    display: flex;
    justify-content: space-between;
    gap: var(--space-m);
    flex-wrap: wrap;
    margin-top: var(--space-2xl);
    padding-top: var(--space-l);
    border-top: var(--border-hairline);
  }
  .doc__step {
    display: grid;
    gap: var(--space-3xs);
    text-decoration: none;
    color: var(--color-text);
    max-width: 22rem;
  }
  .doc__step--next {
    text-align: end;
    margin-inline-start: auto;
  }
  .doc__steplabel {
    font-size: var(--step--1);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-faint);
  }
  .doc__steptitle {
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--color-accent-strong);
  }

  .doc__foot {
    display: flex;
    justify-content: space-between;
    gap: var(--space-m);
    margin-top: var(--space-2xl);
    padding-top: var(--space-l);
    border-top: var(--border-hairline);
    font-size: var(--step--1);
    color: var(--color-text-faint);
  }

  @media (max-width: 52rem) {
    .doc {
      grid-template-columns: 1fr;
    }
    .doc__side {
      position: static;
      height: auto;
      border-inline-end: 0;
      border-block-end: var(--border-hairline);
    }
    .doc__brand {
      margin-bottom: var(--space-m);
    }
    .doc--landing .doc__main {
      padding-top: var(--space-xl);
    }
    .chapter {
      grid-template-columns: 1fr;
      min-height: 0;
      padding: var(--space-l) var(--space-s);
      margin-inline: 0;
      margin-bottom: var(--space-xl);
    }
    .chapter__art {
      order: -1;
      justify-self: start;
      width: clamp(6rem, 26vw, 8rem);
      margin-bottom: var(--space-s);
    }
    .chapter__text {
      max-width: none;
    }
    .hero__title {
      font-size: var(--step-5);
    }
  }
</style>

<style is:global>
  /* On the landing, hold the left reading zone as calm paper so the hero and
     journey stay legible over the bright canopy light; the tree lives right. */
  body[data-landing] .atmos-veil {
    background: linear-gradient(
      100deg,
      color-mix(in srgb, var(--color-bg) 95%, transparent) 0%,
      color-mix(in srgb, var(--color-bg) 86%, transparent) 34%,
      color-mix(in srgb, var(--color-bg) 40%, transparent) 54%,
      transparent 68%
    );
  }
  @media (max-width: 48rem) {
    body[data-landing] .atmos-veil {
      background: linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-bg) 82%, transparent) 40%,
        color-mix(in srgb, var(--color-bg) 55%, transparent) 70%,
        transparent 100%
      );
    }
  }

  /* --- Prose: the Markdown body, styled with tokens only --- */
  .doc-prose {
    font-size: var(--step-1);
    line-height: var(--leading-loose);
    color: var(--color-text-soft);
    overflow-wrap: break-word;
  }
  /* Long unbroken tokens (filenames, ids in code) must wrap, not widen the page. */
  .doc-prose code {
    overflow-wrap: anywhere;
