---
/**
 * Quiet closing footer / colophon. Names the engine honestly (built with
 * WowRepo) without turning into marketing. Content comes from repo data.
 */
import type { ResolvedRepo } from '@engine/load.ts';

interface Props {
  repo: ResolvedRepo;
}

const { repo } = Astro.props;
const { lastUpdated } = repo;
// The colophon year comes from the same deterministic source as the update
// stamp, so it never drifts from the reader's clock. Falls back to the update
// year when present; otherwise the colophon simply carries no year.
const year = lastUpdated ? lastUpdated.iso.slice(0, 4) : undefined;
---

<footer class="site-footer">
  <div class="wr-shell site-footer__inner">
    <p class="site-footer__name">{repo.site.name}</p>
    <p class="site-footer__note">
      {repo.site.tagline}
    </p>
    {lastUpdated && (
      <p class="site-footer__updated">
        Last updated <time datetime={lastUpdated.iso}>{lastUpdated.display}</time>
      </p>
    )}
    <p class="site-footer__colophon">
      A living site composed with <span class="engine">WowRepo</span>{year && ` · ${year}`}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-3xl);
    padding-block: var(--space-xl) var(--space-2xl);
    border-top: var(--border-hairline);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-2xs);
    max-width: var(--measure);
  }

  .site-footer__name {
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--color-text);
  }

  .site-footer__note {
    color: var(--color-text-soft);
    max-width: 40ch;
  }

  .site-footer__updated {
    margin-top: var(--space-xs);
    font-size: var(--step--1);
    color: var(--color-text-soft);
  }

  .site-footer__updated time {
    font-variant-numeric: tabular-nums;
  }

  .site-footer__colophon {
    margin-top: var(--space-2xs);
    font-size: var(--step--1);
    color: var(--color-text-faint);
    letter-spacing: 0.01em;
  }

  .engine {
    color: var(--color-accent-strong);
  }
</style>
