{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-ops-kit.dev/schemas/memory-governance.schema.json",
  "title": "MemoryGovernancePolicy",
  "description": "MemoryGovernancePolicy (MGP) — security-долг #2 (OWASP ASI): у каждой записи памяти обязательны provenance (откуда), expiry (TTL/review/permanent+обоснование) и запрет self-ingestion (собственный вывод агента не становится авторитетной памятью без подтверждения человека). Без этого нельзя расширять автономность/самоизменение.",
  "type": "object",
  "required": ["schema_version", "kind", "policy_id", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "MemoryGovernancePolicy" },
    "policy_id": { "type": "string", "pattern": "^MGP-[0-9]{3,}$" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "provenance", "expiry", "self_ingested"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "provenance": {
            "type": "object",
            "required": ["origin", "source_type"],
            "additionalProperties": false,
            "properties": {
              "origin": { "type": "string", "minLength": 1 },
              "source_type": { "type": "string", "enum": ["human", "external", "derived", "system"] },
              "created_at": { "type": "string" },
              "upstream": { "type": "array", "items": { "type": "string" } }
            }
          },
          "expiry": {
            "type": "object",
            "required": ["mode"],
            "additionalProperties": false,
            "properties": {
              "mode": { "type": "string", "enum": ["ttl_days", "review_date", "permanent"] },
              "value": {},
              "justification": { "type": "string" }
            }
          },
          "self_ingested": { "type": "boolean" },
          "human_confirmed": { "type": "boolean" }
        }
      }
    }
  }
}
