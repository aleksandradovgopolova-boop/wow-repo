{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-ops-kit.dev/schemas/key-lifecycle.schema.json",
  "title": "KeyLifecyclePolicy",
  "description": "KeyLifecyclePolicy (KLP) — security-долг #3 (OWASP ASI): у каждого ключа есть TTL (дедлайн ротации) и ссылка ТОЛЬКО на env (не значение в файле); политика ЧЕСТНО фиксирует, есть ли полноценная per-agent identity (нельзя заявлять её при отсутствии). Значения ключей в политике запрещены.",
  "type": "object",
  "required": ["schema_version", "kind", "policy_id", "keys", "per_agent_identity"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "KeyLifecyclePolicy" },
    "policy_id": { "type": "string", "pattern": "^KLP-[0-9]{3,}$" },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "env_ref", "ttl_days", "rotation_owner"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "env_ref": { "type": "string", "minLength": 1 },
          "ttl_days": { "type": "integer" },
          "rotation_owner": { "type": "string", "enum": ["human", "automated"] },
          "note": { "type": "string" }
        }
      }
    },
    "per_agent_identity": {
      "type": "object",
      "required": ["supported", "note"],
      "additionalProperties": false,
      "properties": {
        "supported": { "type": "boolean" },
        "note": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
